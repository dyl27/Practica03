<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<c:set var="lang" value="${pageContext.response.locale.language}"/>
<c:set var="uri" value="${requestScope['jakarta.servlet.forward.request_uri']}"/>
<!DOCTYPE html>
<html lang="${lang}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><spring:message code="app.title"/></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Source+Sans+3:wght@400;600;700&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@2.3.8/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-buttons-bs5@3.2.6/css/buttons.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-select-bs5@3.1.3/css/select.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-columncontrol-bs5@1.2.1/css/columnControl.bootstrap5.min.css">
    <link rel="stylesheet" href="<c:url value='/css/styles.css'/>">
</head>
<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-md navbar-dark topbar">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="<c:url value='/books'/>">
            <span class="brand-mark"><i class="mdi mdi-bookshelf"></i></span>
            <span class="d-flex flex-column lh-1">
                <span class="brand-name"><spring:message code="app.title"/></span>
                <span class="brand-tagline"><spring:message code="app.tagline"/></span>
            </span>
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-md-4 me-auto">
                <li class="nav-item">
                    <a class="nav-link ${fn:endsWith(uri, '/books') ? 'active' : ''}" href="<c:url value='/books'/>">
                        <i class="mdi mdi-format-list-bulleted"></i> <spring:message code="nav.books"/>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${fn:endsWith(uri, '/new') ? 'active' : ''}" href="<c:url value='/books/new'/>">
                        <i class="mdi mdi-plus-circle-outline"></i> <spring:message code="nav.new"/>
                    </a>
                </li>
            </ul>
            <div class="lang-switch my-2 my-md-0">
                <a class="${lang == 'es' ? 'active' : ''}" href="?lang=es">ES</a>
                <a class="${lang == 'en' ? 'active' : ''}" href="?lang=en">EN</a>
            </div>
        </div>
    </div>
</nav>

<main class="container py-4 py-md-5 flex-grow-1">
